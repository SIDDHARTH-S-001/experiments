{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AKFSFSimulation",
            "type": "shell",
            "command": "g++",
            "args": [
                "../src/main.cpp",
                "../src/beacons.cpp",
                "../src/display.cpp",
                "../src/kalmanfilter.cpp",
                "../src/kalmanfilter_ekf_answer.cpp",
                "../src/kalmanfilter_ekf_student.cpp",
                "../src/kalmanfilter_lkf.cpp",
                "../src/kalmanfilter_lkf_answer.cpp",
                "../src/kalmanfilter_ukf_answer.cpp",
                "../src/kalmanfilter_ukf_student.cpp",
                "../src/sensors.cpp",
                "../src/simulation.cpp",
                "../src/utils.cpp",
                "-I", "../src",
                "-I", "/usr/include/eigen3",
                "-o", "AKFSFSimulation"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
